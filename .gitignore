# Python virtual environments
/.venv/
venv/
env/

# Python cache / compiled files
__pycache__/
*.py[cod]
*.pyo

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editor files
.idea/
.vscode/

# Runtime artifacts
/runs/
/api-jobs/

# Generated vector-store test data
/tests/.chroma_test_data/

# Local evaluation repositories
/eval-repos/

# Keep only summary files from the final evaluation
/evaluation-results/*
!/evaluation-results/BATCH-NOTES.txt
!/evaluation-results/manifest.json
!/evaluation-results/results.csv

# Ignore the older evaluation batch completely
/evaluation-results-v1/

# Secrets / local configuration
.env
.env.*
*.pem
*.key

# Logs / crash files
*.log
crash-log.txt

# Temporary / backup files
*.bak
*.tmp
*~

# OS junk
.DS_Store
Thumbs.db